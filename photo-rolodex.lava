{% comment %}
╔══════════════════════════════════════════════════════════════════╗
║  PHOTO ROLODEX — "Guess the Name" Game  (HTMX + CSS edition)   ║
║  Paste into a Rock RMS HTML Content block.                      ║
║                                                                  ║
║  REQUIREMENTS                                                    ║
║  • Rock RMS 18.0 or later. This project targets 18.0+            ║
║    exclusively -- the {[ dropdown ]} Lava shortcode used on the   ║
║    List field below was seeded in the same v18 migration that     ║
║    added the Lava Applications feature, so this file has no       ║
║    separate, lower version floor of its own anymore.              ║
║  • SQL Lava commands enabled:                                    ║
║    Admin Tools > System Settings > Lava Engine                   ║
║                                                                  ║
║  SOURCES ARE PERSON TAGS. There is no hardcoded CONFIGURATION     ║
║  block to maintain -- the setup screen's dropdown is built live  ║
║  from every active, organization-wide Tag scoped to the Person   ║
║  entity. To add a new "list" to the game, tag the people you     ║
║  want in Rock (Person profile > tag icon, or a Grid's "Tag" bulk ║
║  action) -- nothing in this file needs to change.                ║
╚══════════════════════════════════════════════════════════════════╝
{% endcomment %}

{% comment %}── Read URL page parameters ────────────────────────────────────────{% endcomment %}
{% assign p_action  = 'action'  | PageParameter %}
{% assign p_tag     = 'tag'     | PageParameter %}
{% assign p_mode    = 'mode'    | PageParameter %}
{% assign p_trk     = 'trk'     | PageParameter %}
{% assign p_deck    = 'deck'    | PageParameter %}
{% assign p_idx     = 'idx'     | PageParameter %}
{% assign p_sc      = 'sc'      | PageParameter %}
{% assign p_choice  = 'choice'  | PageParameter %}
{% assign p_choices = 'choices' | PageParameter %}
{% assign p_minfo   = 'minfo'   | PageParameter %}

{% comment %}── Apply defaults ──────────────────────────────────────────────────{% endcomment %}
{% if p_mode == '' %}{% assign p_mode = 'flip' %}{% endif %}

{% comment %}
  AsInteger is the real Rock Lava filter for string-to-int conversion (there
  is no "ToInteger" filter). It returns null -- not 0 -- for a blank or
  non-numeric input, so every conversion below is guarded explicitly rather
  than trusting a zero fallback from the filter itself.
{% endcomment %}
{% assign idx = 0 %}
{% if p_idx != '' %}{% assign idx = p_idx | AsInteger %}{% endif %}
{% assign sc = 0 %}
{% if p_sc != '' %}{% assign sc = p_sc | AsInteger %}{% endif %}
{% assign choiceId = 0 %}
{% if p_choice != '' %}{% assign choiceId = p_choice | AsInteger %}{% endif %}
{% assign trackScore = false %}
{% if p_trk == '1' %}{% assign trackScore = true %}{% endif %}
{% assign showMoreInfo = false %}
{% if p_minfo == '1' %}{% assign showMoreInfo = true %}{% endif %}

{% comment %}── Parse the tag id ─────────────────────────────────────────────────{% endcomment %}
{% assign tagId = 0 %}
{% if p_tag != '' %}{% assign tagId = p_tag | AsInteger %}{% endif %}

{% comment %}── Build shuffled deck on first game request (no deck param yet) ────{% endcomment %}
{% if p_action == 'game' and p_deck == '' and p_tag != '' %}
  {% comment %}
    TaggedItem links to a tagged Person through EntityGuid, not an
    EntityId column (confirmed against Rock.Model.TaggedItem) -- the join
    below is on p.Guid, not p.Id.

    SQL Server doesn't allow ORDER BY NEWID() combined directly with
    SELECT DISTINCT -- ORDER BY items must appear in the select list
    whenever DISTINCT is used, and NEWID() isn't selected. The DISTINCT
    dedup happens in the inner query (in case someone was tagged more
    than once with the same tag); the outer query has no DISTINCT of its
    own, so ordering it by NEWID() is unrestricted.
  {% endcomment %}
  {% sql %}
    SELECT Id
    FROM (
      SELECT DISTINCT p.Id
      FROM TaggedItem ti
      JOIN Person p ON p.Guid = ti.EntityGuid
      WHERE ti.TagId              = {{ tagId }}
        AND p.PhotoId              IS NOT NULL
        AND p.RecordStatusValueId  = 3
    ) AS TaggedPeople
    ORDER BY NEWID()
  {% endsql %}
  {% assign p_deck = '' %}
  {% for row in results %}
    {% if p_deck == '' %}
      {% assign p_deck = row.Id %}
    {% else %}
      {% assign p_deck = p_deck | Append:',' | Append:row.Id %}
    {% endif %}
  {% endfor %}
{% endif %}

{% comment %}── Deck state ──────────────────────────────────────────────────────{% endcomment %}
{% comment %}
  Guard: '' | Split:',' returns [''] in .NET (size 1), not [] (size 0).
  Explicitly zero out totalCards when the deck string is empty.
{% endcomment %}
{% assign deckIds    = p_deck | Split:',' %}
{% assign totalCards = deckIds | Size %}
{% if p_deck == '' %}{% assign totalCards = 0 %}{% endif %}

{% comment %}
  Security: p_deck and p_choices come straight off the URL query string, and
  the distractor/restore queries below interpolate them into a SQL IN().
  Never trust a page parameter directly in SQL -- rebuild a sanitized,
  integer-only CSV here (AsInteger forces anything non-numeric to 0, guarded
  explicitly since AsInteger returns null rather than 0 for blank/non-numeric
  input) and use that in every query instead of the raw p_deck / p_choices
  strings.
{% endcomment %}
{% assign safeDeckCsv = '' %}
{% for d in deckIds %}
  {% assign dInt = 0 %}
  {% if d != '' %}{% assign dInt = d | AsInteger %}{% endif %}
  {% if dInt == null %}{% assign dInt = 0 %}{% endif %}
  {% if forloop.first %}
    {% assign safeDeckCsv = dInt %}
  {% else %}
    {% assign safeDeckCsv = safeDeckCsv | Append:',' | Append:dInt %}
  {% endif %}
{% endfor %}

{% comment %}── Fetch current card ──────────────────────────────────────────────{% endcomment %}
{% assign currentId  = 0 %}
{% assign personName = '' %}
{% assign photoId    = 0 %}

{% if p_action == 'game' and totalCards > 0 and idx < totalCards %}
  {% assign currentId = 0 %}
  {% if deckIds[idx] != '' %}{% assign currentId = deckIds[idx] | AsInteger %}{% endif %}

  {% comment %}
    CampusName, ConnectionStatus, and TaggedSince are cheap scalar
    left-joins added here regardless of showMoreInfo; whether to *display*
    them is decided down in the HTML. TaggedSince comes from
    TaggedItem.CreatedDateTime for this specific tag + person combination
    (a real Model<T> audit column, always populated once someone is tagged).
  {% endcomment %}
  {% sql %}
    SELECT
      p.Id,
      COALESCE(NULLIF(p.NickName,''), p.FirstName) AS DisplayFirst,
      p.LastName,
      p.PhotoId,
      p.PrimaryFamilyId,
      cs.Value AS ConnectionStatus,
      c.Name AS CampusName,
      ti.CreatedDateTime AS TaggedSince
    FROM Person p
    LEFT JOIN DefinedValue cs ON cs.Id = p.ConnectionStatusValueId
    LEFT JOIN Campus c ON c.Id = p.PrimaryCampusId
    LEFT JOIN TaggedItem ti ON ti.TagId = {{ tagId }} AND ti.EntityGuid = p.Guid
    WHERE p.Id = {{ currentId }}
  {% endsql %}
  {% assign curPerson  = results | First %}
  {% assign personName = curPerson.DisplayFirst | Append:' ' | Append:curPerson.LastName %}
  {% assign photoId    = curPerson.PhotoId %}

  {% comment %}── More-info lookups: household + other groups (only when enabled) ─
    Two extra queries per card, only run when the player has the "Show
    more about each person" checkbox on.
  {% endcomment %}
  {% assign familyMembers = '[]' | FromJSON %}
  {% assign otherGroups   = '[]' | FromJSON %}
  {% if showMoreInfo %}
    {% if curPerson.PrimaryFamilyId %}
      {% sql %}
        SELECT
          fm.Id,
          COALESCE(NULLIF(fm.NickName,''), fm.FirstName) AS DisplayFirst,
          fm.LastName
        FROM GroupMember gm
        JOIN Person fm ON fm.Id = gm.PersonId
        WHERE gm.GroupId = {{ curPerson.PrimaryFamilyId }} AND fm.Id != {{ currentId }}
        ORDER BY fm.BirthYear
      {% endsql %}
      {% assign familyMembers = results %}
    {% endif %}

    {% comment %}
      Excludes the Family group type -- people you live with are already
      shown above as "Household." There's no "group being played" to
      exclude anymore since sources are Tags, not Groups. [Group] is
      bracket-wrapped because it's a reserved SQL Server keyword.
    {% endcomment %}
    {% sql %}
      SELECT TOP 3 g.Name
      FROM GroupMember gm
      JOIN [Group] g ON g.Id = gm.GroupId
      JOIN GroupType gt ON gt.Id = g.GroupTypeId
      WHERE gm.PersonId           = {{ currentId }}
        AND gm.GroupMemberStatus  = 1
        AND g.IsActive            = 1
        AND g.IsArchived          = 0
        AND g.IsSecurityRole      = 0
        AND gt.Guid              != '790E3215-3B10-442B-AF69-616C0DCB998E'
      ORDER BY gm.DateTimeAdded DESC
    {% endsql %}
    {% assign otherGroups = results %}
  {% endif %}

  {% comment %}
    Pre-build the info panel once here so the same markup can be reused in
    both flip and quiz modes below without duplicating it -- Lava has no
    macro/function construct, so a captured variable is the standard way
    to share a rendered block of HTML.
  {% endcomment %}
  {% assign moreInfoHtml = '' %}
  {% if showMoreInfo %}
    {% capture moreInfoHtml %}
      <details class="rd-more-info mt-2">
        <summary class="btn btn-default btn-block">More about {{ personName }}</summary>
        <div class="rd-more-info-body mt-2">
          {% if curPerson.CampusName %}<p class="mb-1"><strong>Campus:</strong> {{ curPerson.CampusName }}</p>{% endif %}
          {% if curPerson.ConnectionStatus %}<p class="mb-1"><strong>Connection Status:</strong> {{ curPerson.ConnectionStatus }}</p>{% endif %}
          {% if curPerson.TaggedSince %}<p class="mb-1"><strong>Tagged since:</strong> {{ curPerson.TaggedSince | Date:'MMMM yyyy' }}</p>{% endif %}
          {% if familyMembers.size > 0 %}
            <p class="mb-1"><strong>Household:</strong>
              {% for fm in familyMembers %}{{ fm.DisplayFirst }} {{ fm.LastName }}{% unless forloop.last %}, {% endunless %}{% endfor %}
            </p>
          {% endif %}
          {% if otherGroups.size > 0 %}
            <p class="mb-0"><strong>Also part of:</strong>
              {% for og in otherGroups %}{{ og.Name }}{% unless forloop.last %}, {% endunless %}{% endfor %}
            </p>
          {% endif %}
          {% if curPerson.CampusName == null and curPerson.ConnectionStatus == null and curPerson.TaggedSince == null and familyMembers.size == 0 and otherGroups.size == 0 %}
            <p class="text-muted mb-0">No additional information on file.</p>
          {% endif %}
        </div>
      </details>
    {% endcapture %}
  {% endif %}

  {% comment %}── Quiz choices ──────────────────────────────────────────────────{% endcomment %}
  {% if p_mode == 'quiz' %}
    {% if p_choices == '' %}
      {% comment %} First visit to this card: generate randomized choices via CTE {% endcomment %}
      {% sql %}
        WITH distractors AS (
          SELECT TOP 3
            p.Id,
            COALESCE(NULLIF(p.NickName,''), p.FirstName) AS DisplayFirst,
            p.LastName
          FROM Person p
          WHERE p.Id IN ({{ safeDeckCsv }}) AND p.Id != {{ currentId }}
          ORDER BY NEWID()
        ),
        correct AS (
          SELECT
            p.Id,
            COALESCE(NULLIF(p.NickName,''), p.FirstName) AS DisplayFirst,
            p.LastName
          FROM Person p
          WHERE p.Id = {{ currentId }}
        ),
        all_choices AS (
          SELECT Id, DisplayFirst, LastName FROM correct
          UNION ALL
          SELECT Id, DisplayFirst, LastName FROM distractors
        )
        SELECT Id, DisplayFirst, LastName FROM all_choices ORDER BY NEWID()
      {% endsql %}
      {% assign quizChoices = results %}
      {% comment %} Build choices param string so answer POST can restore order {% endcomment %}
      {% assign p_choices = '' %}
      {% for c in quizChoices %}
        {% if p_choices == '' %}
          {% assign p_choices = c.Id %}
        {% else %}
          {% assign p_choices = p_choices | Append:',' | Append:c.Id %}
        {% endif %}
      {% endfor %}
    {% else %}
      {% comment %} Answer state: restore choices in original display order {% endcomment %}
      {% assign choiceIdList = p_choices | Split:',' %}
      {% comment %} Security: sanitize p_choices the same way as p_deck before it hits SQL. {% endcomment %}
      {% assign safeChoicesCsv = '' %}
      {% for cid in choiceIdList %}
        {% assign cidInt = 0 %}
        {% if cid != '' %}{% assign cidInt = cid | AsInteger %}{% endif %}
        {% if cidInt == null %}{% assign cidInt = 0 %}{% endif %}
        {% if forloop.first %}
          {% assign safeChoicesCsv = cidInt %}
        {% else %}
          {% assign safeChoicesCsv = safeChoicesCsv | Append:',' | Append:cidInt %}
        {% endif %}
      {% endfor %}
      {% sql %}
        SELECT p.Id, COALESCE(NULLIF(p.NickName,''), p.FirstName) AS DisplayFirst, p.LastName
        FROM Person p
        WHERE p.Id IN ({{ safeChoicesCsv }})
      {% endsql %}
      {% assign choicePool = results %}
    {% endif %}
  {% endif %}
{% endif %}

{% comment %}── URL building helpers ────────────────────────────────────────────{% endcomment %}
{% comment %}
  Security: p_tag and p_mode are strings lifted straight from the URL and get
  echoed back into href / hx-get attributes on every screen. UrlEncode them
  before rebuilding any URL so a crafted query string (e.g. tag or mode
  containing quotes/angle brackets) can't break out of the attribute and
  inject markup. deck is rebuilt from safeDeckCsv (integers only) rather
  than the raw p_deck string for the same reason.
{% endcomment %}
{% assign safeTag  = p_tag  | UrlEncode %}
{% assign safeMode = p_mode | UrlEncode %}
{% assign trkVal = '0' %}{% if trackScore %}{% assign trkVal = '1' %}{% endif %}
{% assign minfoVal = '0' %}{% if showMoreInfo %}{% assign minfoVal = '1' %}{% endif %}
{% assign baseGame    = '?action=game&tag=' | Append:safeTag | Append:'&mode=' | Append:safeMode | Append:'&trk=' | Append:trkVal | Append:'&minfo=' | Append:minfoVal | Append:'&deck=' | Append:safeDeckCsv %}
{% assign nextIdx     = idx | Plus:1 %}
{% assign newSc       = sc %}
{% if p_choice != '' and choiceId == currentId %}{% assign newSc = sc | Plus:1 %}{% endif %}
{% assign nextCardUrl = baseGame | Append:'&idx=' | Append:nextIdx | Append:'&sc=' | Append:newSc %}
{% assign playAgainUrl = '?action=game&tag=' | Append:safeTag | Append:'&mode=' | Append:safeMode | Append:'&trk=' | Append:trkVal | Append:'&minfo=' | Append:minfoVal %}

{% comment %}━━━━ STYLES (outside #rolodex-app so they survive HTMX swaps) ━━━━━{% endcomment %}

<style>
/*
  Per the Rock UI skill (triumph-techkit:rock-ui), components/utilities/CSS
  variables come first and custom CSS is a last resort. Everything Rock
  already covers -- the progress bar, photo card shape/shadow/background,
  spacing, and semantic colors -- now uses Rock's native markup and utility
  classes instead of hand-rolled rules; see the HTML below.

  What's left here is only the markup Rock's own components can't produce
  without pulling in Rock's client-side JS, which would break the "no
  JavaScript" requirement for this block:
    - .rd-mode-group: a JS-free segmented radio control. Rock's documented
      radio-button-list and toggle controls both depend on Rock's own
      scripts (js-rockradiobuttonlist / js-toggle-*) to manage the active
      state, so they're not an option here. This uses the native
      :checked + label sibling selector instead.
    - .rd-flip-details: the tap-to-reveal card, built on native
      <details>/<summary> so the reveal needs no script at all.
    - .rd-choices-grid .btn: Bootstrap's .btn sets white-space: nowrap by
      default, which would clip a long person's name instead of wrapping it.

  Any value below that isn't a structural/behavioral necessity (radius,
  color) references a Rock CSS variable rather than a hardcoded hex or px.
*/
#rolodex-app {
  max-width: 480px;
}

.rd-mode-group {
  display: flex;
  width: 100%;
}
.rd-mode-group input[type="radio"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}
.rd-mode-group label {
  flex: 1;
  text-align: center;
  margin: 0;
  cursor: pointer;
  border-radius: 0;
}
.rd-mode-group label:first-of-type { border-radius: var(--rounded-xsmall) 0 0 var(--rounded-xsmall); }
.rd-mode-group label:last-of-type  { border-radius: 0 var(--rounded-xsmall) var(--rounded-xsmall) 0; }
.rd-mode-group input[type="radio"]:checked + label {
  background-color: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
  z-index: 1;
}

.rd-flip-details > summary {
  list-style: none;
  cursor: pointer;
  display: block;
  width: 100%;
  text-align: center;
}
.rd-flip-details > summary::-webkit-details-marker { display: none; }
.rd-flip-details[open] > summary { display: none; }

.rd-choices-grid .btn {
  white-space: normal;
}

/*
  The photo card's 1:1 crop is kept as a plain CSS property rather than
  Rock's ratio-square utility: that utility maintains ratio via a
  padding-bottom technique that expects an absolutely-positioned child,
  and getting that wrong would visibly break the single most important
  element on the screen. The modern aspect-ratio property is simple,
  well-supported, and low-risk for the same result.

  .rd-more-info is the optional "more about this person" panel, also on
  native <details>/<summary>. Unlike the flip card, its summary stays
  visible when open (native toggle behavior) so it can be collapsed again.
*/
.rd-photo-card {
  aspect-ratio: 1 / 1;
}

.rd-more-info > summary {
  list-style: none;
  cursor: pointer;
}
.rd-more-info > summary::-webkit-details-marker { display: none; }
.rd-more-info-body {
  font-size: 0.9rem;
}
</style>

{% comment %}━━━━ HTML ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━{% endcomment %}

<div id="rolodex-app" class="mx-auto px-2">

{% comment %}══════════════ SETUP SCREEN ══════════════{% endcomment %}
{% if p_action == '' or p_action == 'setup' %}

  {% comment %}
    Rock.SystemGuid.EntityType.PERSON is a stable GUID across every Rock
    install (unlike EntityType.Id, which is just an auto-increment value
    that can differ instance to instance) -- confirmed against
    Rock/SystemGuid/EntityType.cs. OwnerPersonAliasId IS NULL means an
    organization-wide tag, not a personal one owned by a single staff
    member's login.
  {% endcomment %}
  {% sql %}
    SELECT t.Id, t.Name
    FROM Tag t
    JOIN EntityType et ON et.Id = t.EntityTypeId
    WHERE et.Guid                = '72657ED8-D16E-492E-AC12-144C5E7567E7'
      AND t.OwnerPersonAliasId   IS NULL
      AND t.IsActive              = 1
    ORDER BY t.[Order], t.Name
  {% endsql %}
  {% assign tags = results %}

  <div class="text-center pt-4 pb-3">
    <i class="fa fa-id-card-o text-primary" style="font-size: 3rem;"></i>
    <h2 class="mt-2 mb-1">Photo Rolodex</h2>
    <p class="text-muted mb-0">Learn names by face, one person at a time.</p>
  </div>

  <form hx-get="." hx-target="#rolodex-app" hx-select="#rolodex-app" hx-push-url="true">
    <input type="hidden" name="action" value="game">

    {% comment %}
      Rock ships a built-in {[ dropdown ]} Lava shortcode (seeded in the
      same v18 migration that added Lava Applications, guid
      7BA8EA13-BC09-4075-B0AF-F88AB1203953) rather than a hand-rolled
      <select>. With longlistenabled:'true' it renders the same
      chosen-select chosen-select-absolute classes documented in the Rock
      UI skill, plus its own inline <script> that calls jQuery's .chosen()
      immediately after the markup renders -- no dependency on this file
      already being loaded once for Rock's global init to find it. This
      project now targets Rock 18.0+ exclusively (the same floor already
      required for the primary Lava Application build), so this file can
      use it too. Options come from child [[ item ]] tags, built
      dynamically here from the tags query above; a leading blank item
      keeps the "-- Choose a List --" placeholder and required-field
      behavior identical to the previous plain <select>.
    {% endcomment %}
    {[ dropdown label:'List' name:'tag' longlistenabled:'true' isrequired:'true' ]}
      [[ item value:'' text:'-- Choose a List --' ]][[ enditem ]]
      {% for t in tags %}
      [[ item value:'{{ t.Id }}' text:'{{ t.Name }}' ]][[ enditem ]]
      {% endfor %}
    {[ enddropdown ]}

    <div class="form-group">
      <label>Game Mode</label>
      <div class="rd-mode-group">
        <input type="radio" name="mode" id="rd-flip" value="flip" checked>
        <label for="rd-flip" class="btn btn-default">
          <i class="fa fa-eye"></i>&nbsp; Tap to Reveal
        </label>
        <input type="radio" name="mode" id="rd-quiz" value="quiz">
        <label for="rd-quiz" class="btn btn-default">
          <i class="fa fa-list-ul"></i>&nbsp; Multiple Choice
        </label>
      </div>
    </div>

    <div class="form-group">
      <div class="checkbox mt-0">
        <label>
          <input type="checkbox" name="trk" value="1" checked>
          Track score (Multiple Choice only)
        </label>
      </div>
      <div class="checkbox mt-0">
        <label>
          <input type="checkbox" name="minfo" value="1" checked>
          Show more about each person (household, campus, etc.) after answering
        </label>
      </div>
    </div>

    <button type="submit" class="btn btn-primary btn-lg btn-block">
      <i class="fa fa-play"></i>&nbsp; Start
    </button>
  </form>

{% comment %}══════════════ GAME SCREEN ══════════════{% endcomment %}
{% elsif p_action == 'game' %}

  {% comment %}── Empty source ──{% endcomment %}
  {% if totalCards == 0 %}

    <div class="alert alert-warning">
      {% if p_tag == '' %}
        <strong>No list selected.</strong>
        Go back and choose one to start.
      {% else %}
        <strong>No people found.</strong>
        Nobody tagged with this list has a profile photo yet.
      {% endif %}
    </div>
    <a href="."
       hx-get="." hx-target="#rolodex-app" hx-select="#rolodex-app" hx-push-url="true"
       class="btn btn-default btn-lg btn-block">
      <i class="fa fa-arrow-left"></i>&nbsp; Back
    </a>

  {% comment %}── All cards done ──{% endcomment %}
  {% elsif idx >= totalCards %}

    <div class="text-center py-4">
      <i class="fa fa-trophy text-warning" style="font-size: 3rem;"></i>
      <h2 class="mt-3">All done!</h2>
      <p class="text-muted">
        You reviewed all <strong>{{ totalCards }}</strong> people.
      </p>
      {% if p_mode == 'quiz' and trackScore %}
        {% assign pct = newSc | Times:100 | DividedBy:totalCards, 0 %}
        <div class="mb-4" style="font-size: 1.25rem;">
          <strong>{{ newSc }} / {{ totalCards }}</strong> correct ({{ pct }}%)
        </div>
      {% endif %}
      <a href="{{ playAgainUrl }}"
         hx-get="{{ playAgainUrl }}" hx-target="#rolodex-app" hx-select="#rolodex-app" hx-push-url="true"
         class="btn btn-primary btn-lg btn-block mb-2">
        <i class="fa fa-refresh"></i>&nbsp; Play Again
      </a>
      <a href="."
         hx-get="." hx-target="#rolodex-app" hx-select="#rolodex-app" hx-push-url="true"
         class="btn btn-default btn-lg btn-block">
        Change List
      </a>
    </div>

  {% comment %}── Active card ──{% endcomment %}
  {% else %}

    {% comment %}── Header: back / progress counter / score ──{% endcomment %}
    <div class="d-flex align-items-center justify-content-between mb-2">
      <a href="."
         hx-get="." hx-target="#rolodex-app" hx-select="#rolodex-app" hx-push-url="true"
         class="btn btn-default btn-sm">
        <i class="fa fa-arrow-left"></i>
      </a>
      <span class="text-muted small">{{ idx | Plus:1 }} / {{ totalCards }}</span>
      {% if p_mode == 'quiz' and trackScore %}
        {% comment %}
          Use newSc, not sc: newSc already reflects this card's just-submitted
          answer (see the "URL building helpers" section above). Displaying sc
          here would leave the score looking stale by one card on the
          post-answer view.
        {% endcomment %}
        <span class="text-muted small">{{ newSc }} correct</span>
      {% else %}
        <span></span>
      {% endif %}
    </div>

    {% comment %}── Progress bar: Rock's native progress component ──{% endcomment %}
    {% assign pct = idx | Times:100 | DividedBy:totalCards, 0 %}
    <div class="progress mb-3">
      <div class="progress-bar" role="progressbar" style="width: {{ pct }}%;"
           aria-valuenow="{{ pct }}" aria-valuemin="0" aria-valuemax="100"></div>
    </div>

    {% comment %}── Photo ──{% endcomment %}
    <div class="rd-photo-card rounded-lg shadow-md bg-gray-100 overflow-hidden mb-3">
      <img src="/GetImage.ashx?Id={{ photoId }}&maxWidth=600" alt="Guess who?"
           class="w-100 h-100 object-cover" style="object-position: center top;" />
    </div>

    {% comment %}────────────────────────────────────────────────────────────────
        FLIP MODE — pure CSS details/summary reveal.
        Clicking the summary opens the details element;
        CSS hides the summary once open and reveals the name + Next link.
    ─────────────────────────────────────────────────────────────────────────{% endcomment %}
    {% if p_mode == 'flip' %}
      <details class="rd-flip-details">
        <summary class="btn btn-primary btn-lg">Tap to Reveal Name</summary>
        <h2 class="text-center my-3">{{ personName }}</h2>
        {{ moreInfoHtml }}
        <a href="{{ nextCardUrl }}"
           hx-get="{{ nextCardUrl }}" hx-target="#rolodex-app" hx-select="#rolodex-app" hx-push-url="true"
           class="btn btn-success btn-lg btn-block mt-2">
          Next &nbsp;<i class="fa fa-arrow-right"></i>
        </a>
      </details>
    {% endif %}

    {% comment %}────────────────────────────────────────────────────────────────
        QUIZ MODE
        Pre-answer:  4 choice buttons, each is an HTMX link.
        Post-answer: disabled colored buttons + result text + Next link.
    ─────────────────────────────────────────────────────────────────────────{% endcomment %}
    {% if p_mode == 'quiz' %}

      {% if p_choice == '' %}

        {% comment %}── Pre-answer: choice buttons ──{% endcomment %}
        <div class="rd-choices-grid d-grid grid-cols-2 gap-3 mb-3">
          {% for c in quizChoices %}
            {% assign choiceUrl = baseGame | Append:'&idx=' | Append:idx | Append:'&sc=' | Append:sc | Append:'&choices=' | Append:p_choices | Append:'&choice=' | Append:c.Id %}
            <a href="{{ choiceUrl }}"
               hx-get="{{ choiceUrl }}" hx-target="#rolodex-app" hx-select="#rolodex-app" hx-push-url="true"
               class="btn btn-default btn-lg">
              {{ c.DisplayFirst }} {{ c.LastName }}
            </a>
          {% endfor %}
        </div>

      {% else %}

        {% comment %}── Post-answer: colored buttons restored in original order ──{% endcomment %}
        <div class="rd-choices-grid d-grid grid-cols-2 gap-3 mb-3">
          {% for cid in choiceIdList %}
            {% comment %}
              Compare as integers on both sides, not raw strings. cid comes
              from splitting the URL's choices param and row.Id comes back
              from SQL -- AsInteger both first so formatting differences
              can't cause a false negative. AsInteger returns null (not 0)
              for a blank/non-numeric input, so both conversions are
              guarded.
            {% endcomment %}
            {% assign cidInt = 0 %}
            {% if cid != '' %}{% assign cidInt = cid | AsInteger %}{% endif %}
            {% if cidInt == null %}{% assign cidInt = 0 %}{% endif %}
            {% for row in choicePool %}
              {% assign rowIdInt = row.Id | AsInteger %}
              {% if rowIdInt == cidInt %}
                {% if cidInt == currentId %}
                  <button type="button" class="btn btn-success btn-lg" disabled>
                    {{ row.DisplayFirst }} {{ row.LastName }}&nbsp;<i class="fa fa-check"></i>
                  </button>
                {% elsif cidInt == choiceId %}
                  <button type="button" class="btn btn-danger btn-lg" disabled>
                    {{ row.DisplayFirst }} {{ row.LastName }}
                  </button>
                {% else %}
                  <button type="button" class="btn btn-default btn-lg o-50" disabled>
                    {{ row.DisplayFirst }} {{ row.LastName }}
                  </button>
                {% endif %}
              {% endif %}
            {% endfor %}
          {% endfor %}
        </div>

        <div style="font-size: 1.1rem;">
          {% if choiceId == currentId %}
            <span class="text-success"><i class="fa fa-check"></i>&nbsp; Correct!</span>
          {% else %}
            <span class="text-danger"><i class="fa fa-times"></i>&nbsp; That's {{ personName }}</span>
          {% endif %}
        </div>

        {{ moreInfoHtml }}

        <div class="text-center mt-3">
          <a href="{{ nextCardUrl }}"
             hx-get="{{ nextCardUrl }}" hx-target="#rolodex-app" hx-select="#rolodex-app" hx-push-url="true"
             class="btn btn-default btn-lg">
            Next &nbsp;<i class="fa fa-arrow-right"></i>
          </a>
        </div>

      {% endif %}

    {% endif %}

  {% endif %}

{% endif %}

</div>
